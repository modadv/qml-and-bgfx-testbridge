{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/testbridge-protocol.schema.json",
  "title": "TestBridge Agent Protocol",
  "type": "object",
  "definitions": {
    "appDescribe": {
      "type": "object",
      "required": ["applicationName", "protocolVersion", "methods", "windows"],
      "properties": {
        "applicationName": {"type": "string"},
        "applicationVersion": {"type": "string"},
        "organizationName": {"type": "string"},
        "qtVersion": {"type": "string"},
        "platformName": {"type": "string"},
        "protocol": {"type": "string"},
        "protocolVersion": {"type": "string"},
        "methods": {"type": "array", "items": {"type": "string"}},
        "windows": {"type": "array", "items": {"type": "object"}}
      }
    },
    "renderCaps": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": {"type": "boolean"},
        "backend": {"type": "string"},
        "tier": {"type": "string"},
        "noCompute": {"type": "boolean"},
        "hasCompute": {"type": "boolean"},
        "hasIndirect": {"type": "boolean"},
        "hasImageRW": {"type": "boolean"},
        "initialized": {"type": "boolean"},
        "lastFrameId": {"type": "integer"}
      }
    },
    "liveShader": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "supportedSlots": {"type": "array", "items": {"type": "string"}},
        "active": {"type": "boolean"},
        "activeSlot": {"type": "string"},
        "activeHash": {"type": "string"},
        "activeSlots": {"type": "array", "items": {"type": "string"}},
        "pending": {"type": "boolean"},
        "revertPending": {"type": "boolean"},
        "lastError": {"type": "string"},
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {"type": "string"},
              "active": {"type": "boolean"},
              "activeHash": {"type": "string"},
              "activeBinPath": {"type": "string"},
              "pending": {"type": "boolean"},
              "revertPending": {"type": "boolean"},
              "lastError": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
